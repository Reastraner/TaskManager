<Window x:Class="TaskManager.Desktop.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager.Desktop"
        xmlns:converters="clr-namespace:TaskManager.Desktop.Converters"
        mc:Ignorable="d"
        Title="Редактирование задачи" Height="400" Width="500"
        ResizeMode='NoResize'
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:PriorityConverter x:Key="PriorityConverter"/>

        <DataTemplate x:Key="PriorityTemplate">
            <TextBlock Text="{Binding Converter={StaticResource PriorityConverter}}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Название задачи: "/>

            <TextBox
            x:Name="TitleTextBox"
            Margin="0, 5, 0, 15"/>

            <TextBlock Text="Описание задачи: "/>

            <TextBox
            x:Name="DescriptionTextBox"
            Margin="0, 5, 0, 15"/>

            <TextBlock Text="Приоритет:"/>

            <ComboBox 
            x:Name="PriorityComboBox"
            ItemTemplate="{StaticResource PriorityTemplate}"
            Margin="0, 5, 0, 15"/>

            <TextBlock 
            Text="Дедлайн:"
            Margin="0, 0, 0, 5"/>

            <DatePicker
            x:Name="DeadlineDatePicker"
            Margin="0, 0, 0, 15"/>

            <TextBlock 
            Text="Время:"
            Margin="0, 0, 0, 5"/>

            <TextBox
            x:Name="DeadlineTimeTextBox"
            Text="23:59"
            Margin="0, 0, 0, 15"/>
            <Button
            Content="Сохранить"
            Click="SaveTaskButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
