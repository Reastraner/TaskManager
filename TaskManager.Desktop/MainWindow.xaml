<Window x:Class="TaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager.Desktop"
        xmlns:converters="clr-namespace:TaskManager.Desktop.Converters"
        mc:Ignorable="d"
        Title="My Task Manager" Height="450" Width="800">

    <Window.Resources>
        <converters:PriorityConverter x:Key="PriorityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock 
            Text="Мои задачи"
            Grid.Row="0"
            Margin="10"
            FontSize="20"/>
        <TabControl
            Grid.Row="1"
            Margin="10">

            <TabItem Header="Все">
                <ListBox
                    x:Name="TaskList"
    >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text=" ["/>
                                <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </TabItem>

            <TabItem Header="Активные">
                <ListBox
                    x:Name="ActiveTaskList"
                    SelectionChanged="ActiveTaskList_SelectionChanged">
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text=" ["/>
                                <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </TabItem>

            <TabItem Header="Выполненные">
                <ListBox
                    x:Name="CompletedTaskList"
                    SelectionChanged="CompletedTaskList_SelectionChanged">
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text=" ["/>
                                <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </TabItem>
            
        </TabControl>
        
        <Grid
            Margin="10"
            Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal">

                <Button
                    Content="Пометить выполненной"
                    x:Name="CompleteTaskButton"
                    Visibility="Collapsed"
                    Margin="0, 0, 10, 0"
                    Padding="15,5"
                    Click="CompleteTaskButton_Click"/>
                <Button
                    Content="Удалить задачу"
                    x:Name="DeleteTaskButton"
                    Visibility="Collapsed"
                    Padding="15,5"
                    Click="DeleteTaskButton_Click"/>
            </StackPanel>

            <Button 
                Content="Добавить задачу" 
                Grid.Column="1"
                Padding="15,5"
                Click="AddTaskButton_Click"/>
        </Grid>
    </Grid>
</Window>
