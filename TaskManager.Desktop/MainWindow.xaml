<Window x:Class="TaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager.Desktop"
        xmlns:converters="clr-namespace:TaskManager.Desktop.Converters"
        mc:Ignorable="d"
        Title="My Task Manager" Height="450" Width="800">

    <Window.Resources>
        <converters:PriorityConverter x:Key="PriorityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock 
            Text="Мои задачи"
            Grid.Row="0"
            Margin="10"
            FontSize="20"/>
        <TabControl
            Grid.Row="1"
            Margin="10">

            <TabItem Header="Все">
                <ListBox
                    x:Name="TaskList"
    >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text=" ["/>
                                <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </TabItem>

            <TabItem Header="Активные">
                <ListBox
                    x:Name="ActiveTaskList">
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text=" ["/>
                                <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </TabItem>

            <TabItem Header="Выполненные">
                <ListBox
                    x:Name="CompletedTaskList">
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text=" ["/>
                                <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </TabItem>
            
        </TabControl>
        
        <Button 
            Content="Добавить задачу" 
            Grid.Row="2"
            Margin="10"
            Padding="15,5"
            HorizontalAlignment="Right"/>
    </Grid>
</Window>
